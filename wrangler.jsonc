{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insurance-annual-report",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // 必须包含 pages_build_output_dir，否则 Git 集成构建时本配置被跳过
  // （nodejs_compat / vars 均不会生效）。静态文件在仓库根目录，故设为 "."
  "pages_build_output_dir": ".",
  // KV 绑定请在 Dashboard 手动配置（Settings → Functions → KV namespace bindings → STORE）
  "vars": {
    "DB_KEY": "raw_data.json",
    "TPL_KEY": "template_163.json",
    "PDF_PREFIX": "pdfs/",
    "STATUS_KEY": "status.json",
    "SOURCES_KEY": "sources.json"
  }
}
