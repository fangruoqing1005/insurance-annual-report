{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insurance-annual-report",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // 存储绑定：使用 Workers KV（免费套餐，无需绑卡）替代 R2
  // 手动部署（Dashboard）方式：Settings → Functions → KV namespace bindings → Variable name: STORE
  // id 可在 Dashboard → Workers & Pages → KV → 创建 namespace 后复制；使用 wrangler 部署时才需要填
  "kv_namespaces": [
    { "binding": "STORE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "DB_KEY": "raw_data.json",
    "TPL_KEY": "template_163.json",
    "PDF_PREFIX": "pdfs/",
    "STATUS_KEY": "status.json",
    "SOURCES_KEY": "sources.json"
  }
}
